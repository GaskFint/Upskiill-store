# Copy to `.env.local` (local dev) or set in Vercel / Cloudflare dashboard.
# Never commit real secrets.

# Stripe (live or test keys)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Resend
RESEND_API_KEY=re_...
# Optional: use after verifying your domain in Resend (e.g. purchases@upskiill.com)
RESEND_FROM_EMAIL=upskiill <onboarding@resend.dev>

# Google Drive folders (one per course)
DRIVE_LINK_CHATGPT_MAKE_MONEY=https://drive.google.com/drive/folders/...
DRIVE_LINK_AI_AGENTS_MASTERCLASS=https://drive.google.com/drive/folders/...
DRIVE_LINK_CAPCUT_MASTERY=https://drive.google.com/drive/folders/...

# Shorter aliases (optional fallbacks)
# DRIVE_LINK_CHATGPT=
# DRIVE_LINK_AI_AGENTS=
# DRIVE_LINK_CAPCUT=
